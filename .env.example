# Copy this file to ".env" and fill in the real values.
# .env is git-ignored so credentials never get committed.

# ── SMTP credentials for info@vjdesai.com ─────────────────────────
# vjdesai.com is hosted on Microsoft 365 (MX: *.mail.protection.outlook.com),
# so use the Office 365 SMTP relay on port 587 with STARTTLS.
SMTP_HOST=smtp.office365.com    # Microsoft 365 SMTP submission endpoint
SMTP_PORT=587                   # 587 = STARTTLS (required by Office 365)
SMTP_SECURE=false               # false for 587 (STARTTLS), true only for 465
SMTP_USER=info@vjdesai.com      # full mailbox login
SMTP_PASS=your-mailbox-or-app-password
# NOTE: Microsoft 365 disables SMTP AUTH by default. You must:
#   1. Enable "Authenticated SMTP" for this mailbox (M365 Admin > Users >
#      info@vjdesai.com > Mail > Manage email apps > tick Authenticated SMTP), and
#   2. If MFA is on, generate an App Password and use it as SMTP_PASS.

# ── Email routing ─────────────────────────────────────────────────
FROM_EMAIL=info@vjdesai.com     # must equal SMTP_USER for Office 365
FROM_NAME=V J Desai & Co. website
TO_EMAIL=info@vjdesai.com       # where enquiries are delivered

# ── Server ────────────────────────────────────────────────────────
PORT=3000

# ── Blog admin panel ──────────────────────────────────────────────
# Key required to create/delete blog posts via the /admin panel.
ADMIN_KEY=choose-a-strong-secret

# ── EmailJS (frontend contact form) ───────────────────────────────
# These are bundled into the browser by Vite — only put the *public*
# EmailJS keys here, never private/admin secrets.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Career page application emails (separate template — needs {{full_name}},
# {{position}}, {{cv_link}}, {{cv_filename}}, {{cover_note}}, {{reply_to}}, etc.)
VITE_EMAILJS_CAREER_TEMPLATE_ID=

# ── Uploadcare (Career page CV hosting) ───────────────────────────
# Public key from uploadcare.com — used to upload CVs and produce a
# permanent ucarecdn.com download URL that's emailed via EmailJS.
VITE_UPLOADCARE_PUBLIC_KEY=

# ── Web3Forms (Career page CV uploads) ────────────────────────────
# Public access key from web3forms.com. Handles attachments server-side
# so we never need a backend for CV uploads.
VITE_WEB3FORMS_KEY=
