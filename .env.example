# Copy this file to ".env" and fill in the real values.
# .env is git-ignored so credentials never get committed.

# ── SMTP credentials for info@vjdesai.com ─────────────────────────
SMTP_HOST=smtp.hostinger.com   # your mail host (smtp.hostinger.com / smtp.gmail.com / mail.vjdesai.com …)
SMTP_PORT=465                  # 465 = SSL, 587 = STARTTLS
SMTP_SECURE=true               # true for port 465, false for port 587
SMTP_USER=info@vjdesai.com     # full mailbox login
SMTP_PASS=your-mailbox-password-or-app-password

# ── Email routing ─────────────────────────────────────────────────
FROM_EMAIL=info@vjdesai.com    # must be allowed by the SMTP account above
FROM_NAME=V J Desai & Co. website
TO_EMAIL=info@vjdesai.com      # where enquiries are delivered

# ── Server ────────────────────────────────────────────────────────
PORT=3000
